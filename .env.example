# ---------- Database ----------
# Matches docker-compose.yml. Change it if you use a local or hosted PostgreSQL (Neon, Supabase...).
# URL-encode special characters in the password (e.g. @ → %40).
DATABASE_URL="postgresql://evoting:evoting@localhost:5432/evoting?schema=public"

# ---------- Security ----------
# Long random string used to sign session tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Password for the admin console (demo only — use real admin accounts in production).
ADMIN_PASSWORD="admin123"

# ---------- Hidden admin console ----------
# Secret URL of the admin login page. It is never linked from the voter site, and every
# /admin URL returns 404 unless you are signed in. Pick something hard to guess.
# Leave empty to use /admin/login directly (development only).
ADMIN_LOGIN_PATH="/officer-change-me"

# ---------- Face matching ----------
# Euclidean distance between face descriptors. Lower = stricter.
# 0.45 strict, 0.5 balanced, 0.6 lenient. Tune with your own tests.
FACE_MATCH_THRESHOLD="0.5"

# Where the browser loads face-api models from. `npm install` copies them into
# public/models/face-api, so the camera works offline.
NEXT_PUBLIC_FACE_MODELS_URL="/models/face-api"

# ---------- Edge Impulse face detector ----------
# "true"  = use your Edge Impulse WebAssembly export from public/models/edge-impulse/
# "false" = always use face-api's built-in detector
NEXT_PUBLIC_USE_EDGE_IMPULSE="true"
NEXT_PUBLIC_EDGE_IMPULSE_MIN_CONFIDENCE="0.6"

# While your export is not in public/models/edge-impulse/ yet:
# "true"  = run the demo model (same output format as the real export)
# "false" = fall back to plain face-api detection
NEXT_PUBLIC_DEMO_MODEL="true"

# ---------- Email (Brevo) ----------
# Brevo → SMTP & API → API keys. Sender must be verified in Brevo (Senders, Domains & Dedicated IPs).
# Leave empty to skip emails (they are logged as "skipped"; voting still works).
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="FaceVote Elections"

# ---------- Edge Impulse (training data upload) ----------
# Edge Impulse Studio → your project → Dashboard → Keys. Works on the free plan.
EDGE_IMPULSE_API_KEY=""

# ---------- Public info shown in emails/messages ----------
APP_URL="http://localhost:3000"
ELECTION_OFFICE_CONTACT="your sector's election office"

# ---------- Email provider ----------
# "gmail" = send through your Gmail account with an App Password (see docs/EDGE_IMPULSE_QUICK_STEPS.md)
# "brevo" = send through Brevo (BREVO_* settings above)
EMAIL_PROVIDER="gmail"

# ---------- Gmail (App Password) ----------
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password named "FaceVote": https://myaccount.google.com/apppasswords
# 3. Paste the 16 characters below WITHOUT spaces. Never commit this file.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Name voters see as the sender
EMAIL_SENDER_NAME="FaceVote Elections"

# Stricter limit used only to flag a possible duplicate registration (the officer can confirm a different person).
DUPLICATE_FACE_THRESHOLD="0.4"

# While your Edge Impulse model is still weak: if it finds no face in a frame, use face-api for that frame.
# Set to "false" once your model is accurate (F1 above ~0.85).
NEXT_PUBLIC_EDGE_IMPULSE_FALLBACK="true"
